<Window x:Class="ClaudeGameHelper.Panel.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeGameHelper.Panel"
        Title="Claude Game Helper"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Width="440" Height="900" MinWidth="300" MinHeight="300"
        Background="#1E1F22" Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Accent" Color="#D97757" />
        <SolidColorBrush x:Key="Muted" Color="#8B8D93" />
        <SolidColorBrush x:Key="Surface" Color="#2B2D31" />
        <SolidColorBrush x:Key="ErrorBrush" Color="#F28B82" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <local:PathToThumbnailConverter x:Key="Thumbnail" />

        <Style x:Key="FlatButton" TargetType="ButtonBase">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
        </Style>

        <DataTemplate x:Key="MessageTemplate" DataType="{x:Type local:ChatMessage}">
            <Border x:Name="Bubble" Margin="0,0,0,10" Padding="10,8" CornerRadius="6" Background="Transparent">
                <StackPanel>
                    <TextBlock x:Name="Header" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,3" />
                    <TextBlock x:Name="Plain" Text="{Binding Text}" TextWrapping="Wrap" />
                    <ItemsControl x:Name="Shots" ItemsSource="{Binding Screenshots}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Converter={StaticResource Thumbnail}}" Height="48" Margin="0,0,4,4" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <local:MarkdownView x:Name="Rich" Text="{Binding Text}" Visibility="Collapsed"
                                        Foreground="#E6E6E6" FontFamily="Segoe UI" FontSize="13" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="You">
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource Surface}" />
                    <Setter TargetName="Header" Property="Text" Value="You" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Claude">
                    <Setter TargetName="Header" Property="Text" Value="{Binding ModelLabel, StringFormat=Claude · {0}, TargetNullValue=Claude}" />
                    <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Shots" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Rich" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Note">
                    <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Shots" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Plain" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="Plain" Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="Watch">
                    <Setter TargetName="Header" Property="Text" Value="👀 Watch" />
                    <Setter TargetName="Plain" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Shots" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Rich" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource Muted}" />
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="2,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAlert}" Value="True">
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource Accent}" />
                    <Setter TargetName="Bubble" Property="Background" Value="#33D97757" />
                    <Setter TargetName="Header" Property="Text" Value="👀 Watch · heads up" />
                    <Setter TargetName="Header" Property="Foreground" Value="{StaticResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter TargetName="Rich" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: drag to move -->
        <StackPanel Grid.Row="0">
        <DockPanel Background="#18191C" MouseLeftButtonDown="Header_MouseLeftButtonDown">
            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource FlatButton}" Click="Hide_Click" ToolTip="Hide (focus goes back to the game)" />
            <Button DockPanel.Dock="Right" Content="Not a game" Style="{StaticResource FlatButton}" Click="NotAGame_Click"
                    Visibility="{Binding IsAutoProfile, Converter={StaticResource BoolToVis}}"
                    ToolTip="Stop treating this program as a game (its notes are kept)" />
            <StackPanel Orientation="Horizontal" Margin="12,8">
                <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" Visibility="{Binding TrackingLabel, Converter={StaticResource NullToCollapsed}}">
                    <TextBlock Text="{Binding TrackingLabel, StringFormat={}{0}:}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding TrackingNames}" SelectedItem="{Binding ActiveTrackingName}" MinWidth="120" Focusable="False" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Watch mode's current goal -->
        <DockPanel Background="#22D97757" Visibility="{Binding WatchGoalText, Converter={StaticResource NullToCollapsed}}">
            <Button DockPanel.Dock="Right" Content="✕ Stop" Style="{StaticResource FlatButton}" Click="StopWatching_Click"
                    ToolTip="Stop watching for this" />
            <TextBlock Margin="12,4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#E6E6E6">
                <Run Text="👀 Watching: " Foreground="{StaticResource Accent}" /><Run Text="{Binding WatchGoalText, Mode=OneWay}" />
            </TextBlock>
        </DockPanel>
        </StackPanel>

        <!-- Conversation -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,10">
            <ItemsControl ItemsSource="{Binding Messages}" ItemTemplate="{StaticResource MessageTemplate}" />
        </ScrollViewer>

        <!-- Status -->
        <StackPanel Grid.Row="2" Margin="12,0,12,6" Visibility="{Binding StatusText, Converter={StaticResource NullToCollapsed}}">
            <ProgressBar IsIndeterminate="True" Height="2" BorderThickness="0" Background="Transparent" Foreground="{StaticResource Accent}"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <DockPanel Margin="0,4,0,0">
                <Button DockPanel.Dock="Right" Content="Stop" Style="{StaticResource FlatButton}" Click="Stop_Click"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </StackPanel>

        <!-- Ask box -->
        <Border Grid.Row="3" Background="#18191C" Padding="12,8,12,10">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding PendingScreenshots}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,6,6">
                                <Image Source="{Binding Converter={StaticResource Thumbnail}}" Height="64" />
                                <Button Content="✕" Tag="{Binding}" Click="RemovePending_Click" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Background="#CC000000" Foreground="White" BorderThickness="0" Padding="4,0" Focusable="False" ToolTip="Remove" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="QuestionBox" Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="160" VerticalScrollBarVisibility="Auto"
                         Background="{StaticResource Surface}" Foreground="#E6E6E6" CaretBrush="#E6E6E6" BorderThickness="0" Padding="6"
                         PreviewKeyDown="QuestionBox_PreviewKeyDown" PreviewMouseDown="QuestionBox_PreviewMouseDown"
                         ToolTip="Enter sends · Shift+Enter new line · Esc hides" />
                <DockPanel Margin="0,6,0,0">
                    <ToggleButton DockPanel.Dock="Right" Content="Deep" IsChecked="{Binding Deep}" Style="{StaticResource FlatButton}"
                                  ToolTip="Use the stronger model for this question" />
                    <CheckBox Content="Include screenshot" IsChecked="{Binding IncludeScreenshot}" Foreground="{StaticResource Muted}"
                              VerticalAlignment="Center" Focusable="False" />
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
